{
  "name": "javascript-react-assignments",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm --prefix task1 ci && npm --prefix task2 ci",
    "dev": "npm run dev:task2",
    "dev:task1": "npm --prefix task1 run dev -- --port 5174 --strictPort",
    "dev:task2": "npm --prefix task2 run dev -- --port 5175 --strictPort",
    "test": "npm --prefix task1 test",
    "lint": "npm --prefix task2 run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm test && npm run lint",
    "build": "node scripts/build.mjs",
    "preview": "node task2/node_modules/vite/bin/vite.js preview --host 127.0.0.1"
  },
  "devDependencies": {
    "prettier": "^3.9.8"
  }
}
